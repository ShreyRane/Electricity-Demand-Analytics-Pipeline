# Replace YOUR_LOCAL_PASSWORD with the password you set for PostgreSQL.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/electricity_analytics

# Set to 15min for 15-minute readings, or 1h for hourly readings.
EXPECTED_FREQUENCY=15min

# Broad validation bounds; adjust to the geographic area and units in your source.
MIN_TEMP_C=-10
MAX_TEMP_C=60

# A load step is flagged (not deleted) if the change exceeds BOTH the MW minimum
# and the percentage threshold relative to the previous observation.
LOAD_JUMP_MIN_MW=50
LOAD_JUMP_PCT=0.20
